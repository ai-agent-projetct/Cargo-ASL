# Copy to a private deployment environment; never commit actual secrets.
NODE_ENV=production
APP_ORIGIN=
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=cargo_asl
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_SSL=true
# Provider CA certificate, with literal \n between certificate lines if required.
MYSQL_SSL_CA=
COOKIE_SECURE=true
INTAKE_ADMIN_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
# Set only after verifying managed backups, recovery and uptime/error alerting.
OPERATIONS_VERIFIED=false
